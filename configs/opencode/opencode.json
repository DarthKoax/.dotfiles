{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "secure-commander": {
      "type": "local",
      "command": [
        "/home/koax/code/mcp/secure-commander"
      ],
      "enabled": false
    },
    "secure-requester": {
      "type": "local",
      "command": [
        "node",
        "/home/koax/code/mcp/secure-requester/dist/index.js"
      ],
      "enabled": false
    },
    "secure-requester-go": {
      "type": "local",
      "command": [
        "/home/koax/code/mcp/secure-requester-go/dist/secure-requester"
      ],
      "env": {
        "SECURE_REQUESTER_CONFIG": "/home/koax/code/mcp/secure-requester-go/mock-config.json"
      },
      "enabled": true
    }
  },
  "permission": {
    "secure-commander_run_secure_cmd": "ask",
    "secure-requester_run_secure_request": "allow",
    "secure-requester_run_secure_request_mutate": "ask",
    "secure-requester.run_secure_request": "allow",
    "secure-requester.run_secure_request_mutate": "ask",
    "secure-requester-go_run_secure_request_mutate": "ask",
    "secure-requester-go.run_secure_request": "allow",
  },
  "provider": {
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio (local)",
      "options": {
        "baseURL": "http://localhost:1234/v1",
        "apiKey": "lmstudio"
      },
      "models": {
        "google/gemma-4-26b-a4b": {
          "name": "gemma-4-26b-a4b"
        },
        "qwen/qwen3-coder-30b": {
          "name": "qwen3-coder-30b"
        },
        "google/gemma-4-e4b": {
          "name": "google/gemma-4-e4b"
        }
      }
    },
    "ollama": {
      "npm": "@ai-sdk/openai",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1",
        "apiKey": "ollama"
      },
      "models": {
        "gemma4:27b": {
          "name": "gemma4:27b"
        },
        "qwen2.5-coder:14b": {
          "name": "qwen2.5-coder:14b"
        },
        "xxx:latest": {
          "name": "xxx"
        },
        "qwen3.6:27b": {
          "name": "qwen3.6:27b"
        }
      }
    }
  },
  "model": "opencode-go/qwen3.7-plus"
}
